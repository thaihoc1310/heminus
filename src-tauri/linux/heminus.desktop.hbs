[Desktop Entry]
Categories={{categories}}
{{#if comment}}Comment={{comment}}{{/if}}
Exec={{exec}}
StartupNotify=true
StartupWMClass=heminus
SingleMainWindow=false
Icon={{icon}}
Name={{name}}
Terminal=false
Type=Application
Actions=open-workspace;new-terminal;

[Desktop Action open-workspace]
Name=Open Workspace
Exec={{exec}}
Icon={{icon}}

[Desktop Action new-terminal]
Name=Open Local Terminal
Exec={{exec}} --new-terminal
Icon={{icon}}
