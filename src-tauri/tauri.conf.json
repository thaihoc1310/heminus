{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Heminus",
  "version": "0.1.1",
  "identifier": "app.heminus.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Heminus",
        "width": 1440,
        "height": 900,
        "minWidth": 480,
        "minHeight": 360,
        "center": true,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "fullscreen": false,
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "A focused SSH workspace",
    "longDescription": "Heminus is a focused, local-first SSH, SFTP and terminal workspace.",
    "linux": {
      "deb": {
        "desktopTemplate": "linux/heminus.desktop.hbs",
        "depends": [
          "openssh-client"
        ]
      }
    }
  }
}
